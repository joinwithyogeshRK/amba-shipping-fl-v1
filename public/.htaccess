# AMBA Shipping & Logistics — Apache / LiteSpeed configuration
#
# Hostinger serves the current site from Apache-compatible hosting, so this file
# does two jobs: permanently redirect the old ASP.NET-era URLs (every one of
# which 404s today), and route everything else to the single-page app.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- force HTTPS ---------------------------------------------------------
  # The current site is served over plain HTTP and Chrome marks it Not Secure.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- legacy URLs (301, case-insensitive) ---------------------------------
  RewriteRule ^Default\.aspx$   /            [NC,L,R=301]
  RewriteRule ^index\.html$     /            [NC,L,R=301]
  RewriteRule ^About\.aspx$     /about       [NC,L,R=301]
  RewriteRule ^Services\.aspx$  /services    [NC,L,R=301]
  RewriteRule ^contact\.aspx$   /contact     [NC,L,R=301]
  RewriteRule ^Gallery\.html$   /            [NC,L,R=301]
  RewriteRule ^sitemap\.aspx$   /            [NC,L,R=301]
  RewriteRule ^Portfolio\.aspx$ /services    [NC,L,R=301]

  # --- single-page app fallback --------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(js|css|woff2|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
